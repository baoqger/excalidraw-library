      "height": 558.3328247070314,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#d0bfff",
      "fillStyle": "cross-hatch",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3T",
      "roundness": null,
      "seed": 734460527,
      "version": 832,
      "versionNonce": 4046113,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791857744372,
      "created": 1791852155484,
      "link": null,
      "locked": false,
      "text": "1. Gateway receives request and routes to Foundry to generate vector embeddings.\n2. Run semantic search on Azure Managed Redis.\n3. Cache hit: response the request with the cached data.\n4. Cache miss: gateway routes request to Foundry for chat completion. \n5. Write Foundry's answer back to Redis for future use.",
      "fontSize": 89.33325195312501,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Gateway receives request and routes to Foundry to generate vector embeddings.\n2. Run semantic search on Azure Managed Redis.\n3. Cache hit: response the request with the cached data.\n4. Cache miss: gateway routes request to Foundry for chat completion. \n5. Write Foundry's answer back to Redis for future use.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
